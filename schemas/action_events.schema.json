{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action_events.schema.json",
  "title": "Stable Action Event",
  "type": "object",
  "required": [
    "action_event_id", "action", "source_segment_ids", "person_ref",
    "lock_epoch", "start_time", "end_time", "status", "training_eligible"
  ],
  "properties": {
    "action_event_id": {"type": "string", "minLength": 1},
    "action": {"type": "string"},
    "source_segment_ids": {
      "type": "array", "minItems": 1, "items": {"type": "string"}
    },
    "person_ref": {"type": "string"},
    "lock_epoch": {"type": "integer", "minimum": 0},
    "start_time": {"type": "number", "minimum": 0},
    "end_time": {"type": "number", "minimum": 0},
    "status": {"enum": ["proposed", "uncertain", "lost"]},
    "training_eligible": {"const": false}
  },
  "additionalProperties": true
}
