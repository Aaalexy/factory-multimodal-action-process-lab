{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "process_review_queue.schema.json",
  "title": "Process Review Queue",
  "type": "object",
  "required": ["schema_version", "items", "status"],
  "properties": {
    "schema_version": {"const": "process_review_queue_v1"},
    "status": {
      "enum": ["proposed", "uncertain", "not_observed", "unavailable"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "review_item_id", "source_video_sha256", "recording_group_id",
          "person_ref", "lock_epoch", "source_model_version", "reviewer",
          "reviewed_at", "training_approval", "training_eligible"
        ],
        "properties": {
          "review_item_id": {"type": "string"},
          "source_video_sha256": {"type": "string"},
          "recording_group_id": {"type": "string"},
          "person_ref": {"type": "string"},
          "lock_epoch": {"type": "integer"},
          "source_model_version": {"type": "string"},
          "reviewer": {"type": ["string", "null"]},
          "reviewed_at": {"type": ["string", "null"]},
          "training_approval": {"type": "string"},
          "training_eligible": {"const": false}
        }
      }
    }
  },
  "additionalProperties": true
}
